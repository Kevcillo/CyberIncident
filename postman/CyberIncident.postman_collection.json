{
  "info": {
    "name": "CyberIncident API",
    "description": "Peticiones de la API de incidentes con seguridad. Ejecutar en orden con el servidor encendido. Primero se inicia sesión y los tokens se guardan solos. El incidente de prueba se crea y se elimina dentro de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAnalista",
      "value": ""
    },
    {
      "key": "idCreado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Inicio de sesión",
      "item": [
        {
          "name": "01 Login administrador",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@cyberincident.com\",\n  \"contrasena\": \"Admin123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('entrega un token de admin', () => pm.expect(pm.response.json().datos.usuario.rol).to.eql('admin'));",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login analista",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"analista@cyberincident.com\",\n  \"contrasena\": \"Analista123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('entrega un token de analista', () => pm.expect(pm.response.json().datos.usuario.rol).to.eql('analista'));",
                  "pm.collectionVariables.set('tokenAnalista', pm.response.json().datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Perfil del usuario conectado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/perfil",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('no envía la contraseña', () => pm.expect(pm.response.text()).to.not.include('contrasena'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Casos correctos",
      "item": [
        {
          "name": "04 Estado del servicio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/estado",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Listar incidentes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve una lista', () => pm.expect(pm.response.json().datos).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Filtrar por estado y prioridad",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes?estado=Abierto&prioridad=Alta",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('todos cumplen el filtro', () => pm.response.json().datos.forEach((i) => { pm.expect(i.estado).to.eql('Abierto'); pm.expect(i.prioridad).to.eql('Alta'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Crear incidente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Ransomware en servidor\",\n  \"tipo\": \"Malware\",\n  \"prioridad\": \"Crítica\",\n  \"fecha\": \"2026-10-02\",\n  \"reportadoPor\": \"soporte@empresa.com\",\n  \"descripcion\": \"Archivos cifrados en el servidor de archivos principal.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('se crea abierto', () => pm.expect(pm.response.json().datos.estado).to.eql('Abierto'));",
                  "pm.collectionVariables.set('idCreado', pm.response.json().datos.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Obtener el incidente creado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes/{{idCreado}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Actualizar estado con PATCH",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/incidentes/{{idCreado}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"En investigación\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('el estado cambió', () => pm.expect(pm.response.json().datos.estado).to.eql('En investigación'));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Reemplazar completo con PUT",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/incidentes/{{idCreado}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Ransomware contenido\",\n  \"tipo\": \"Malware\",\n  \"prioridad\": \"Alta\",\n  \"estado\": \"Cerrado\",\n  \"fecha\": \"2026-10-02\",\n  \"responsable\": \"Equipo de Seguridad\",\n  \"descripcion\": \"El equipo afectado fue aislado y los archivos se restauraron desde respaldo.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('quedó cerrado', () => pm.expect(pm.response.json().datos.estado).to.eql('Cerrado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Eliminar como administrador",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/incidentes/{{idCreado}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 Casos de error y seguridad",
      "item": [
        {
          "name": "12 Listar sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Listar con token inválido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "abc.def.ghi",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@cyberincident.com\",\n  \"contrasena\": \"incorrecta\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "15 Eliminar como analista",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/incidentes/1",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAnalista}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 403', () => pm.response.to.have.status(403));",
                  "pm.test('indica que se requiere admin', () => pm.expect(pm.response.json().mensaje).to.include('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 Crear con datos inválidos",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Ab\",\n  \"tipo\": \"Virus\",\n  \"prioridad\": \"Urgente\",\n  \"fecha\": \"2026-13-45\",\n  \"reportadoPor\": \"correo-malo\",\n  \"descripcion\": \"corta\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('indica el error de cada campo', () => ['titulo', 'tipo', 'prioridad', 'fecha', 'reportadoPor', 'descripcion'].forEach((c) => pm.expect(pm.response.json().errores).to.have.property(c)));"
                ]
              }
            }
          ]
        },
        {
          "name": "17 Crear con campos no permitidos",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Ransomware en servidor\",\n  \"tipo\": \"Malware\",\n  \"prioridad\": [\n    \"Alta\"\n  ],\n  \"fecha\": \"2026-10-02\",\n  \"reportadoPor\": \"soporte@empresa.com\",\n  \"descripcion\": \"Archivos cifrados en el servidor de archivos principal.\",\n  \"rol\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('rechaza rol y el tipo de prioridad', () => { const e = pm.response.json().errores; pm.expect(e.rol).to.eql('Campo no permitido.'); pm.expect(e.prioridad).to.eql('Debe ser un texto.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "18 Crear con JSON mal escrito",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/incidentes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{titulo: sin comillas"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "19 PUT incompleto",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/incidentes/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Cerrado\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "20 Filtro no permitido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes?estado=Perdido",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "21 Id que no es número",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes/abc",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "22 Obtener el incidente eliminado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidentes/{{idCreado}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "23 Origen no permitido por CORS",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/estado",
            "header": [
              {
                "key": "Origin",
                "value": "http://sitio-malicioso.com"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "24 Ruta inexistente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/no-existe",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
